/* HKG Flight Data — new TUI theme (Textual)
 *
 * Every full-width widget runs edge to edge with no horizontal padding. The
 * views render at the terminal width, so a widget's content width must equal
 * the terminal width too: any padding here makes Textual re-wrap each line at
 * its last word - which pushed "(12/09/2026)" onto a row of its own. The gutter
 * lives in the renderer instead: the header, nav and footer start with a space,
 * and a flight row starts with its two-cell selection marker.
 *
 * Each of the four chrome widgets is exactly one row tall. That is what
 * views.CHROME_ROWS counts; the body gets whatever is left.
 */

Screen {
    background: #122937;
    color: #e2edf1;
}

#header {
    background: #0d1f2b;
    color: #e2edf1;
    height: 1;
}

#nav {
    color: #8ec9df;
    height: 1;
}

#search_row {
    height: 1;
}

#search_label {
    color: #bad2df;
}

#search_input {
    border: none;
    background: #1a3547;
    color: #e2edf1;
    width: 1fr;
}

#search_input:focus {
    border: solid #edb64a;
    background: #1d3b4f;
}

#body {
    height: 1fr;
}

#footer {
    height: 1;
    color: #8ec9df;
    background: #0d1f2b;
}
